# ---------------------------------------------------------------------------
# Dreams Happen Ltd — environment configuration
# Copy to `.env` and fill in. The app runs without real Stripe keys in a
# self-contained "test checkout" mode (useful for local dev and e2e tests).
# ---------------------------------------------------------------------------

# Public base URL of the site (used for Stripe redirect URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret used to sign admin sessions and download tokens. Use a long random
# value in production (e.g. `openssl rand -hex 32`).
APP_SECRET=dev-only-insecure-secret-change-me

# Admin CMS credentials (the /admin area gates PDF distribution).
ADMIN_EMAIL=admin@dreamshappenltd.com
ADMIN_PASSWORD=changeme

# Stripe (test mode). Leave the secret key blank/placeholder to use the
# built-in simulated checkout instead of calling the real Stripe API.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Storefront currency (Dubai / UAE)
NEXT_PUBLIC_CURRENCY=AED
