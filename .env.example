# ---------------------------------------------------------------------------
# Dreams Happen Ltd — environment configuration
# Copy to `.env` and fill in. The app runs without real Stripe/Resend keys:
# checkout falls back to a simulated payment and emails are logged to console.
# ---------------------------------------------------------------------------

# Public base URL (used for OG metadata; runtime URLs are derived per-request)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database: Postgres (Supabase in production) ---------------------------
# DATABASE_URL  -> pooled connection (Supabase: port 6543, ?pgbouncer=true)
# DIRECT_URL    -> direct connection for migrations (Supabase: port 5432)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dreamshappen?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/dreamshappen?schema=public

# Secret for signing admin sessions and download tokens (openssl rand -hex 32)
APP_SECRET=change-me

# Admin CMS credentials (the /admin area controls PDF distribution)
ADMIN_EMAIL=admin@dreamshappenltd.com
ADMIN_PASSWORD=change-me

# --- Stripe (test or live) -------------------------------------------------
# Leave STRIPE_SECRET_KEY blank to use the built-in simulated checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Resend transactional email --------------------------------------------
# Leave RESEND_API_KEY blank to log confirmation emails to the console.
RESEND_API_KEY=
EMAIL_FROM=Dreams Happen <onboarding@resend.dev>

# Storefront currency (Dubai / UAE)
NEXT_PUBLIC_CURRENCY=AED
